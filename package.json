{
  "name": "statix-data-analyzer",
  "productName": "Statix Data Analyzer",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop application for data analysis",
  "author": "Alberto",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:electron": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.analisis.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "ml-cart": "^2.1.1",
    "ml-kmeans": "^7.0.1",
    "ml-regression-multivariate-linear": "^2.0.4",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-d3-tree": "^3.6.7",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "simple-statistics": "^7.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
